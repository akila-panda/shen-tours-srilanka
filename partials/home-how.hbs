<!-- 11. How it works -->
<section id="how" class="how py-section" data-section="how" aria-labelledby="how-title">
  <div class="wrap">
    <p class="label text-ink-muted">How it works</p>
    <h2 id="how-title" class="mt-5 text-display-lg">Three steps<br /><span class="script text-script-lg normal-case">to the road</span></h2>

    <div class="how-steps-wrap mt-14 md:mt-20">
    <span class="how-line" aria-hidden="true"><span class="how-line-fill" data-how-line></span></span>
    <ol class="how-steps">
      <li class="how-step" data-how-step>
        <span class="how-num">01</span>
        <h3 class="mt-6 text-display-sm">Tell us your dates</h3>
        <p class="mt-3 max-w-[22rem] text-body text-ink-muted">Send your dates, group size and the places you'd like to see, on WhatsApp or by message.</p>
      </li>
      <li class="how-step" data-how-step>
        <span class="how-num">02</span>
        <h3 class="mt-6 text-display-sm">We plan the route</h3>
        <p class="mt-3 max-w-[22rem] text-body text-ink-muted">We agree the route and the price with you before you arrive, and can book hotels along the way if you want.</p>
      </li>
      <li class="how-step" data-how-step>
        <span class="how-num">03</span>
        <h3 class="mt-6 text-display-sm">We meet you at the airport</h3>
        <p class="mt-3 max-w-[22rem] text-body text-ink-muted">Your driver-guide meets you at arrivals, and you can change plans day by day.</p>
      </li>
    </ol>
    </div>

    <div class="how-tailor mt-16 md:mt-24">
      <div>
        <p class="label">Tailor-made</p>
        <p class="mt-4 font-display text-display-md uppercase">None of the five tours quite right?</p>
        <p class="mt-4 max-w-prose text-body">Tell us what you'd like to see and how many days you have, and we'll plan a route around it.</p>
      </div>
      {{#if quoteUrl}}<a href="{{quoteUrl}}" class="btn-solid">Plan a tailor-made tour <span aria-hidden="true">→</span></a>{{/if}}
    </div>
  </div>
</section>
