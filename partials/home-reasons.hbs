<!-- 3. Three reasons over Sigiriya (becomes Moment 2, the Sigiriya climb, in R4) -->
<section id="reasons" class="reasons" data-section="reasons" aria-labelledby="reasons-title">
  <div class="reasons-stage" data-reasons-stage>
    <img class="reasons-photo" src="{{photos.sigiriya.src}}" alt="{{photos.sigiriya.alt}}" width="1600" height="1067" loading="lazy" data-reasons-img />
    <div class="wrap reasons-inner">
      <h2 id="reasons-title" class="reasons-title">Three reasons to travel with Shen</h2>
      <ol class="reasons-notes">
        <li class="note" style="--r: -2.5deg" data-reason>
          <span class="note-num" aria-hidden="true">1</span>
          <h3>Just your group, no strangers</h3>
          <p>Your own air-conditioned car or van and driver-guide for the whole trip.</p>
        </li>
        <li class="note" style="--r: 1.5deg" data-reason>
          <span class="note-num" aria-hidden="true">2</span>
          <h3>Local driver-guides</h3>
          <p>{{business.stats.guides}} English-speaking guides, each with {{guideYearsMin}}+ years of guiding, led by founder Shashen Bhanuka.</p>
        </li>
        <li class="note" style="--r: -1deg" data-reason>
          <span class="note-num" aria-hidden="true">3</span>
          <h3>Clear prices</h3>
          <p>From {{money business.fromPricePerPersonPerDay business.currency}} per person per day. Fuel, parking, airport pickup and passenger insurance included.</p>
        </li>
      </ol>
    </div>
  </div>
</section>
