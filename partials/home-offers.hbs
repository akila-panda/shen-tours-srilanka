{{#if offers.length}}
<!-- 9. Seasonal offers as ticket stubs; offers.js re-checks validTo in the browser -->
<section id="offers" class="offers" data-section="offers" aria-labelledby="offers-title">
  <div class="wrap">
    <div class="offers-head">
      <h2 id="offers-title">Seasonal offers</h2>
      {{#if quoteUrl}}<a href="{{quoteUrl}}" class="link-hand">ask about an offer →</a>{{/if}}
    </div>
    <ul class="offers-grid">
      {{#each offers}}
      <li class="stub" data-offer {{#if validTo}}data-valid-to="{{validTo}}"{{/if}}>
        <p class="stub-value">{{discountPercent}}% <span class="hand">off</span></p>
        <h3>{{title}}</h3>
        {{#if terms}}<span class="stamp">{{terms}}</span>{{/if}}
      </li>
      {{/each}}
    </ul>
  </div>
</section>
{{/if}}
