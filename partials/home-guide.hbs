<!-- 7. Meet your guide. Shashen's own words render only once he supplies them. -->
<section id="guides" class="guide" data-section="guide" aria-labelledby="guide-title">
  <div class="wrap">
    <div class="guide-grid">
      <figure class="print guide-portrait" data-guide-portrait>
        <div class="ph" role="img" aria-label="Portrait of {{founder.name}}, founder and driver-guide" data-guide-img><span class="label">Photo to come</span></div>
        <figcaption>{{founder.name}}</figcaption>
      </figure>

      <div class="guide-copy">
        <h2 id="guide-title">Meet your guide<span class="hand">{{founder.name}}, “Shen”</span></h2>
        <p class="mt-6 max-w-prose text-body-lg">
          {{firstName founder.name}} founded {{business.name}} in {{business.foundedYear}} and brings
          {{founder.years}} years of guiding. The whole team are English-speaking driver-guides from Sri
          Lanka, and one of them stays with your group for the whole trip.
        </p>
        {{#if founder.quote}}
        <blockquote class="guide-letter ruled">
          <p class="hand" style="font-size: var(--text-hand-lg)">“{{founder.quote}}”</p>
          <footer class="label mt-4">{{founder.name}}, founder</footer>
        </blockquote>
        {{/if}}
      </div>
    </div>

    <ul class="guide-cards" aria-label="The driver-guides">
      {{#each guides}}
      <li class="guide-card" data-guide-card>
        <figure class="print">
          <div class="ph" role="img" aria-label="Portrait of {{name}}"><span>{{initials name}}</span></div>
          <figcaption>{{years}} years guiding</figcaption>
        </figure>
        <p class="font-display text-display-sm font-extrabold uppercase">{{name}}</p>
        <p class="text-small text-ink-soft">{{role}}</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
