<!-- 7. Meet your guide (Fitzroy-style portrait + statement; Shashen's own quote renders once supplied) -->
<section id="guides" class="guide py-section" data-section="guide" aria-labelledby="guide-title">
  <div class="wrap">
    <div class="guide-grid">
      <div class="guide-portrait" data-guide-portrait>
        <div class="ph h-full w-full" role="img" aria-label="Portrait of {{founder.name}}, founder and driver-guide" data-guide-img>
          <span class="label opacity-80">Photo to come · {{founder.name}}</span>
        </div>
      </div>

      <div class="guide-copy">
        <p class="label text-ink-muted">Meet your guide</p>
        <h2 id="guide-title" class="mt-6 text-display-lg">
          {{founder.name}}
          <span class="script mt-1 block text-script-md">“Shen”</span>
        </h2>
        <p class="mt-8 max-w-prose text-body-lg">
          {{firstName founder.name}} founded {{business.name}} in {{business.foundedYear}} and brings
          {{founder.years}} years of guiding. The whole team are English-speaking driver-guides from Sri
          Lanka, and one of them stays with your group for the whole trip.
        </p>
        {{#if founder.quote}}
        <blockquote class="guide-quote mt-10">
          <p class="font-display text-display-md uppercase">“{{founder.quote}}”</p>
          <footer class="label mt-4 text-ink-muted">{{founder.name}}, founder</footer>
        </blockquote>
        {{/if}}
      </div>
    </div>

    <h3 class="label mt-20 text-ink-muted md:mt-28">The driver-guides</h3>
    <ul class="guide-cards mt-6">
      {{#each guides}}
      <li class="guide-card" data-guide-card>
        <div class="ph guide-card-photo{{#if (odd @index)}} is-hills{{/if}}" role="img" aria-label="Portrait of {{name}}">
          <span class="font-display text-display-md">{{initials name}}</span>
        </div>
        <p class="mt-4 font-display text-display-sm uppercase">{{name}}</p>
        <p class="label mt-2 text-ink-muted">{{role}} · {{years}} years</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
