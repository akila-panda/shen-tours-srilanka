<!-- 5. Tours: railway tickets on the left, a sticky photo print on the right -->
<section id="tours" class="tours on-dark" data-section="tours" aria-labelledby="tours-title">
  <div class="wrap">
    <div class="tours-head">
      <h2 id="tours-title">Sri Lanka<br />tour packages</h2>
      <p class="hand">Five routes. Fares are per person for the car and your driver-guide; hotels are separate.</p>
    </div>

    <div class="tours-grid">
      <ol class="tours-list" data-tours-list>
        {{#each tours}}
        <li class="tour-item{{#if @first}} is-active{{/if}}" data-tour-item>
          <a class="ticket" href="{{quoteUrl}}">
            <span class="t-top"><span>{{@root.business.name}}</span><span>No. 00{{index}}</span></span>
            <span class="t-route"><small>Colombo airport to</small><h3>{{title}}</h3></span>
            <span class="t-foot"><span>{{durationDays}} days · {{nights}} nights<br />Best {{bestMonths}}</span><span class="t-fare">Fare from<b>{{money pricing.from pricing.currency}}</b></span></span>
          </a>
          <figure class="print tour-photo-inline" style="--ratio: 4 / 3; --r: 1deg">
            {{#with (photo @root.photos photo.key)}}<img src="{{src}}" alt="{{alt}}" loading="lazy" width="1600" height="1200" />{{else}}<div class="ph" role="img" aria-label="{{photo.alt}}"><span class="label">Photo to come</span></div>{{/with}}
            <figcaption>{{photo.placeholder}}</figcaption>
          </figure>
        </li>
        {{/each}}
      </ol>

      <div class="tours-panel" aria-hidden="true">
        <div class="tours-frame">
          {{#each tours}}
          <figure class="print tours-photo{{#if @first}} is-active{{/if}}" style="--r: {{#if (odd @index)}}2deg{{else}}-2deg{{/if}}" data-tour-photo>
            {{#with (photo @root.photos photo.key)}}<img src="{{src}}" alt="" loading="lazy" width="1600" height="2000" />{{else}}<div class="ph"><span class="label">Photo to come · {{../photo.placeholder}}</span></div>{{/with}}
            <figcaption>{{photo.placeholder}}</figcaption>
            <span class="stamp">From {{money pricing.from pricing.currency}} · {{durationDays}} days</span>
          </figure>
          {{/each}}
        </div>
      </div>
    </div>

    <div class="tours-foot">
      {{#if quoteUrl}}<a href="{{quoteUrl}}" class="btn-ticket">Ask for a tailor-made route →</a>{{/if}}
      <p class="hand">Transfers from {{money business.transfersFrom business.currency}} · day trips from {{money business.dayTripsFromPerDay business.currency}} a day</p>
    </div>
  </div>
</section>
