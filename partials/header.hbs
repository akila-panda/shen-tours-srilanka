<a href="#main" class="label sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-paper focus:px-4 focus:py-3 focus:text-ink">Skip to content</a>

<header class="site-header" data-section="header">
  <div class="wrap flex h-header items-center justify-between gap-4">
    <a href="/" class="badge" aria-label="{{business.name}}, home">
      <svg class="badge-ring" viewBox="0 0 100 100" aria-hidden="true">
        <defs><path id="badge-path" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0" /></defs>
        <circle cx="50" cy="50" r="48" stroke-width="2" />
        <circle cx="50" cy="50" r="29" stroke-width="1.2" />
        <text><textPath href="#badge-path" textLength="228" lengthAdjust="spacing">{{business.name}} · since {{business.foundedYear}} ·</textPath></text>
      </svg>
      <span class="badge-mark" aria-hidden="true">Shen<br />Tours</span>
    </a>

    <nav class="flex items-center gap-3 md:gap-6" aria-label="Quick links">
      {{#if business.whatsapp}}
      <a class="label hidden items-center gap-2 lg:inline-flex" href="https://wa.me/{{digits business.whatsapp}}">WhatsApp {{business.whatsapp}}</a>
      {{/if}}
      {{#if quoteUrl}}<a class="btn-ticket max-[359px]:hidden" href="{{quoteUrl}}">Plan my tour →</a>{{/if}}
      <a href="#menu" class="menu-btn" aria-controls="menu" aria-expanded="false" data-menu-open>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
        <span class="max-sm:sr-only">Menu</span>
      </a>
    </nav>
  </div>
</header>

<!-- Full-screen menu. Without JavaScript it opens via :target (#menu). -->
<div id="menu" class="site-menu" role="dialog" aria-modal="true" aria-label="Menu" data-menu>
  <div class="wrap flex h-header items-center justify-between">
    <p class="label">{{business.name}}</p>
    <a href="#" class="menu-btn" data-menu-close>
      <span class="menu-icon is-close" aria-hidden="true"><i></i><i></i></span>
      Close
    </a>
  </div>
  <nav class="wrap pt-6 pb-12 md:pt-10" aria-label="Main">
    <ul class="menu-links">
      <li><a href="#tours">Tours <span class="hand">five routes</span></a></li>
      <li><a href="#where">Where to go <span class="hand">the island</span></a></li>
      <li><a href="#guides">Your guides <span class="hand">meet Shen</span></a></li>
      <li><a href="#how">How it works <span class="hand">three steps</span></a></li>
      <li><a href="#faq">FAQ <span class="hand">questions</span></a></li>
      <li><a href="#contact">Contact <span class="hand">WhatsApp</span></a></li>
    </ul>
  </nav>
  <div class="wrap grid gap-6 border-t border-line-light py-8 sm:grid-cols-2">
    {{#if business.whatsapp}}<p><span class="label block">WhatsApp</span><a class="mt-2 inline-block font-display text-display-sm font-black" href="https://wa.me/{{digits business.whatsapp}}">{{business.whatsapp}}</a></p>{{/if}}
    {{#if business.phone}}<p><span class="label block">Phone</span><a class="mt-2 inline-block font-display text-display-sm font-black" href="tel:+{{digits business.phone}}">{{business.phone}}</a></p>{{/if}}
  </div>
</div>

<!-- Odometer on the left edge (decorative): rolls up as you go down the page. -->
<div class="odometer" aria-hidden="true">
  <span class="hand">journey</span>
  <span class="odometer-digits" data-odometer>
    <span class="odometer-digit"><span>0</span></span>
    <span class="odometer-digit"><span>0</span></span>
    <span class="odometer-digit"><span>0</span></span>
  </span>
</div>
