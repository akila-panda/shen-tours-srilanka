<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{page.title}}</title>
<meta name="description" content="{{page.description}}" />
{{#unless page.index}}<meta name="robots" content="noindex, nofollow" />{{/unless}}
{{#if business.domain}}
<link rel="canonical" href="https://{{business.domain}}{{page.path}}" />
<meta property="og:url" content="https://{{business.domain}}{{page.path}}" />
{{/if}}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="{{business.name}}" />
<meta property="og:title" content="{{page.title}}" />
<meta property="og:description" content="{{page.description}}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#F3F3EC" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..700&family=Instrument+Serif:ital@0;1&family=Pinyon+Script&display=swap"
/>
{{#if jsonLd}}<script type="application/ld+json">{{{jsonLd}}}</script>{{/if}}
<script>document.documentElement.classList.add('js')</script>
