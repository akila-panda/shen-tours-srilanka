<!-- 10. Guest journal: prints on laterite. Only real, named reviews and the guests' own videos. -->
<section id="journal" class="journal on-dark" data-section="journal" aria-labelledby="journal-title">
  <div class="wrap">
    <div class="journal-head flex flex-wrap items-end justify-between gap-6">
      <h2 id="journal-title">Guest journal<span class="hand">from the road</span></h2>
      {{#if business.socials.tripadvisor}}<a href="{{business.socials.tripadvisor}}" class="link-hand" rel="noopener">read our reviews on Tripadvisor →</a>{{/if}}
    </div>
    <ol class="journal-board">
      {{#each videos}}
      <li class="journal-card" data-journal-card>
        <figure class="print">
          <div class="ph" {{#unless src}}role="img" aria-label="Guest video {{numeral}}, to be added"{{/unless}}><span class="journal-play" aria-hidden="true">▶</span></div>
          <figcaption>{{numeral}}. {{#if guest}}{{guest}}{{else}}guest story{{/if}}</figcaption>
        </figure>
      </li>
      {{/each}}
    </ol>
    {{#if reviews.length}}
    <ul class="mt-16 grid gap-10 md:grid-cols-2">
      {{#each reviews}}
      <li><blockquote><p class="text-body-lg">“{{text}}”</p><footer class="label mt-4">{{author}}{{#if country}}, {{country}}{{/if}} · <a href="{{sourceUrl}}" class="underline" rel="noopener">{{source}}</a></footer></blockquote></li>
      {{/each}}
    </ul>
    {{/if}}
  </div>
</section>
