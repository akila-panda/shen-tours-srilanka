<!-- 6. Where to go: stair-stepped heading, a frangipani print, then prints of the destinations -->
<section id="where" class="where" data-section="where" aria-labelledby="where-title">
  <div class="wrap where-head">
    <h2 id="where-title" class="where-title">
      <span class="where-line" data-where-line="0">Where</span>
      <span class="where-line" data-where-line="1"><span class="hand">to go</span> in</span>
      <span class="where-line" data-where-line="2">Sri Lanka</span>
    </h2>
    <figure class="print where-flower" data-where-flower><img src="{{photos.plumeria.src}}" alt="{{photos.plumeria.alt}}" loading="lazy" width="900" height="1125" /><figcaption>frangipani</figcaption></figure>
    <p class="where-intro">From the rock fortress at Sigiriya to the elephants of Minneriya and Udawalawe, the leopards of Yala and the fort walls of Galle, your driver-guide plans the route around the places you want to see.</p>
  </div>

  <div class="where-strip" data-where-strip>
    <div class="where-viewport" tabindex="0" role="region" aria-label="Destinations in Sri Lanka" data-where-viewport>
      <ol class="where-track" data-where-track>
        {{#each destinations}}
        <li class="dest-card">
          <figure class="print">
            {{#with (photo @root.photos photo.key)}}<img src="{{src}}" alt="{{alt}}" loading="lazy" width="900" height="1125" />{{else}}<div class="ph" role="img" aria-label="{{photo.alt}}"><span class="label">Photo to come</span></div>{{/with}}
            <figcaption>{{region}}</figcaption>
          </figure>
          <p class="meta"><b>{{name}}</b><span class="label text-ink-soft">{{index}}</span></p>
        </li>
        {{/each}}
      </ol>
    </div>
  </div>
</section>
